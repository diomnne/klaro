# Copy to .env.local and fill in. .env.local is gitignored — never commit a real key.

# Google Gemini API key, used by the /draft chat.
# Create one at https://aistudio.google.com/apikey
# Read server-side only (app/api/chat/route.ts); it is never sent to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=
